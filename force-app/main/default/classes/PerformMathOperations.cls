public class PerformMathOperations {
    //method defintion
 public Integer performAdditionOfInteger(Integer num1, Integer num2)
 {
     Integer result=num1+num2;
     return result;
 }
    public Integer performSubtractionOfInteger(Integer num1, Integer num2)
 {
     Integer result=num1-num2;
     return result;
 }
    public Integer performMultiplicationOfInteger(Integer num1, Integer num2)
 {
     Integer result=num1*num2;
     return result;
 }
    public Integer performDivisionOfInteger(Integer num1, Integer num2)
 {
     Integer result=num1/num2;
     return result;
 }
}